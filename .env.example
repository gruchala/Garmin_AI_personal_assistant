GARMIN_EMAIL=twoj_email@example.com
GARMIN_PASSWORD=twoje_haslo
OPENAI_API_KEY=sk-your-api-key
RAW_DATA_STORAGE=essential

# Ochrona API wystawionego na serwerze
# Ustaw własny długi sekret przed wystawieniem API poza localhost.
# AGENT_API_TOKEN=super_dlugi_losowy_token
# AGENT_API_HEADER=X-Agent-Token
# PUBLIC_HEALTHCHECK=true
# CORS_ALLOW_ORIGINS=https://grucha.me,https://www.grucha.me

# Konfiguracja lokalnego MCP servera
# Zwykle MCP działa na tym samym serwerze co FastAPI i łączy się po localhost.
# MCP_BACKEND_URL=http://127.0.0.1:8000
# MCP_API_BASE_PATH=/api/v1
# MCP_API_TOKEN=super_dlugi_losowy_token
# MCP_REQUEST_TIMEOUT_SECONDS=30

# Opcjonalnie: jawna ścieżka do bazy. Domyślnie projekt używa sqlite:///garmin_data.db
# DATABASE_URL=sqlite:///garmin_data.db

# Opcjonalnie: email przez SMTP
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=twoj_email@gmail.com
# EMAIL_SMTP_PASSWORD=twoj_app_password
# EMAIL_TO=twoj_email@gmail.com

# Opcjonalnie: WhatsApp przez Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+48XXXXXXXXX
