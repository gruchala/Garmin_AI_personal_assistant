# Garmin Connect credentials
GARMIN_EMAIL=twoj_email@example.com
GARMIN_PASSWORD=twoje_haslo

# OpenAI API (opcjonalne - dla funkcji AI)
OPENAI_API_KEY=sk-your-api-key-here

# Database
DATABASE_URL=sqlite:///garmin_data.db
# Lub PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/garmin_ai

# Twilio WhatsApp (opcjonalne - dla raportów porannych)
# 1. Załóż konto na https://www.twilio.com (Sandbox WhatsApp = darmowy test)
# 2. Account SID i Auth Token znajdziesz w konsoli: https://console.twilio.com
# 3. Numer nadawcy Sandbox: whatsapp:+14155238886
#    (lub zatwierdzony numer businessowy po pełnej aktywacji)
# 4. Numer odbiorcy (Twój WhatsApp): whatsapp:+48XXXXXXXXX
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+48XXXXXXXXX

# Email notifications (opcjonalne — Gmail, Outlook lub inny SMTP)
# Gmail: włącz 2FA → Konto Google → Bezpieczeństwo → Hasła do aplikacji → wygeneruj hasło
# Outlook/Hotmail: EMAIL_SMTP_HOST=smtp.office365.com, EMAIL_SMTP_PORT=587
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=twoj_email@gmail.com
EMAIL_SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_TO=twoj_email@gmail.com

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
